// What the title screen offers.
//
// A scenario is a world plus the units standing on it. Add one here and it appears on
// the menu — no Rust, no restart beyond the one you were going to do anyway.
//
// Order is the order they are listed, so it is your decision rather than an accident.
//
// FIELDS
//
//   name      what the button says
//   blurb     one line underneath, saying what is interesting about this one
//   world     the map file, as a path under `assets/`
//   lighting  OPTIONAL sun/sky/cloud file. Omit it for the shipped look
//   generation_seed  OPTIONAL Some(reproducible seed) for generated maps
//   starting_time_hours  OPTIONAL Some(hour in [0, 24)) for cyclic lighting
//   units     where the pieces start: Fixed(cube coordinate) or Anchor("name")
//
// `lighting` is what makes one scenario feel unlike another as much as its terrain
// does -- it carries the sun's angle and colour, so it decides which way the shadows
// fall, not just what the sky looks like.
//
// The `world` and `lighting` paths are NOT checked by the compiler — nothing here knows what a map is,
// deliberately, so that this file does not have to be edited whenever the map format
// changes. A typo is caught by a test that opens every world named here, so a wrong
// path fails `cargo test` rather than at the loading screen.
//
// Fixed COORDINATES are CUBE coordinates and MUST SUM TO ZERO: x + y + z == 0. That
// is what makes them a hex grid rather than three loose numbers.
// See https://www.redblobgames.com/grids/hexagons/
//
// Generated maps use Anchor("stable_name") instead. The generator publishes the exact
// TilePos for each anchor after validating the map, so rerolling does not require
// rewriting unit coordinates. A missing or non-standable anchor is logged and that unit
// is not spawned; it never silently moves to the centre.
(
    scenarios: [
        (
            name: "The Crossing",
            blurb: "A river with one bridge over it, a mountain, and a switchback up the side.",
            world: "config/world.ron",
            // No `lighting`, so this one gets `config/lighting.ron`.
            units: (
                // Opposite ends of the bridge, so the first movement test is the
                // crossing this scenario is built around.
                player: Fixed((x: 0, y: 4, z: -4)),

                enemy: Fixed((x: 0, y: -4, z: 4)),
            ),
        ),
        (
            name: "Procedural Hills",
            blurb: "Seeded temperate hills split by a river, with a bridge and a longer alternate crossing.",
            world: "config/worlds/procedural-hills.ron",
            generation_seed: Some(1592598566),
            units: (
                player: Anchor("party_start"),
                enemy: Anchor("hostile_start"),
            ),
        ),
        (
            name: "Rolling Hills",
            blurb: "Open procedural ground under heavy cloud. Nowhere to funnel through, so distance is the only obstacle.",
            world: "config/worlds/rolling-hills.ron",
            lighting: "config/lighting/overcast.ron",
            units: (
                player: Fixed((x: 0, y: 0, z: 0)),

                // Closer than on the Crossing, because there is no terrain in the way
                // to make the walk interesting.
                enemy: Fixed((x: 5, y: -5, z: 0)),
            ),
        ),
        (
            name: "Frozen Hills",
            blurb: "A cold-environment probe using the same crossing guarantees as the temperate hills.",
            world: "config/worlds/procedural-frozen.ron",
            lighting: "config/lighting/overcast.ron",
            generation_seed: Some(484450342),
            units: (
                player: Anchor("party_start"),
                enemy: Anchor("hostile_start"),
            ),
        ),
        (
            name: "Volcanic Hills",
            blurb: "A basalt and lava probe with a cooled alternate crossing.",
            world: "config/worlds/procedural-volcanic.ron",
            generation_seed: Some(444211238),
            units: (
                player: Anchor("party_start"),
                enemy: Anchor("hostile_start"),
            ),
        ),
        (
            name: "Sky Islands",
            blurb: "A floating-island probe with a connected critical route and optional unreachable islands.",
            world: "config/worlds/procedural-sky-islands.ron",
            generation_seed: Some(94445606),
            units: (
                player: Anchor("party_start"),
                enemy: Anchor("hostile_start"),
            ),
        ),
        (
            name: "Close Quarters",
            blurb: "Both pieces spawn within engagement range, so the fight starts at once — the combat-loop showcase.",
            world: "config/world.ron",
            units: (
                // The Crossing's player spawn and its off-bridge neighbour on the
                // same bank: adjacent, so combat begins on entry and the enemy's
                // first turn is a strike rather than a march.
                player: Fixed((x: 0, y: 4, z: -4)),

                enemy: Fixed((x: 1, y: 4, z: -5)),
            ),
        ),
    ],
)

// Authoritative gameplay sight ranges.
//
// These values do not sample rendered lights, shadows, or exposure. Perception
// selects one radius from the target's deterministic illumination tier. Downward
// targets keep the full horizontal radius; upward distance consumes the same exact
// radius budget.
(
    active: Expansive,

    expansive: (
        bright: (radius: 36),
        dim: (radius: 12),
        dark: (radius: 1),
    ),
    focused: (
        bright: (radius: 24),
        dim: (radius: 8),
        dark: (radius: 1),
    ),
    tight: (
        bright: (radius: 18),
        dim: (radius: 6),
        dark: (radius: 1),
    ),
)

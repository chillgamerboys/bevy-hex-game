// What the world is made of.
//
// Each entry registers a substance that a voxel can use. Adding one here makes it
// available to the game, but terrain generation must select it before it appears
// in a generated world.
//
// `air` is special: id 0 always means empty space. The table synthesizes the same
// non-solid, non-diggable sentinel if this explicit entry is omitted, but keeping it
// here makes the authored contract visible. The terrain presets select the other
// entries by name; changing their properties is safe, but renaming them requires
// updating the generation code.
//
// Runtime ids are a compatibility contract rather than file order. The original
// vocabulary keeps its shipped ids, followed by reserved Outpost slots for
// limestone, slate, timber, and terracotta, then sand. Missing reserved entries are
// inert and cannot be resolved by name; see docs/development/config.md before adding
// another registry slot. A name added only to this file is rejected.
(
    substances: {
        "air": (
            // Never drawn, so air is intentionally absent from the art palette.
            swatch: None,
            // Nothing stands on air.
            solid: false,
            // There is nothing to dig out of it.
            diggable: false,
            // Empty space is never a substance a spell can create.
            conjurable: false,
            // Empty space has no damageable voxel body.
            toughness: None,
        ),

        "grass": (
            swatch: Some("terrain/grass"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(1),
        ),

        "dirt": (
            swatch: Some("terrain/dirt"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(2),
        ),

        "stone": (
            swatch: Some("terrain/stone"),
            solid: true,
            diggable: true,
            // The current construction spells name stone explicitly.
            conjurable: true,
            toughness: Some(4),
        ),

        "gravel": (
            swatch: Some("terrain/gravel"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(2),
        ),

        // Loose coastal terrain. Swimming and erosion rules remain deferred, so
        // sand currently follows the ordinary diggable-solid contract.
        "sand": (
            swatch: Some("terrain/sand"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(2),
        ),

        // Rendered as a voxel but excluded from movement footing. It remains
        // clearable through the same terrain-edit rule as dirt and stone.
        "water": (
            swatch: Some("liquid/water"),
            solid: false,
            diggable: true,
            conjurable: false,
            toughness: None,
        ),

        // Metal is on the toughest initial durability tier.
        "metal": (
            swatch: Some("structure/metal"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(8),
        ),

        // Cut and fitted masonry used by generated walls, towers, stairs, and keeps.
        // Fitted masonry shares the toughest initial durability tier with metal.
        "worked_stone": (
            swatch: Some("structure/worked-stone"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(8),
        ),

        // Procedural-environment materials. Their behaviour is intentionally simple
        // until temperature, slipping, and hazards exist.
        "snow": (
            swatch: Some("terrain/snow"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(1),
        ),

        "ice": (
            swatch: Some("terrain/ice"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(2),
        ),

        "basalt": (
            swatch: Some("terrain/basalt"),
            solid: true,
            diggable: true,
            conjurable: false,
            toughness: Some(4),
        ),

        // Lava is an opaque, non-solid voxel and deliberately opts out of toughness.
        // Fluid redistribution and emissive rendering remain separate concerns.
        "lava": (
            swatch: Some("liquid/lava"),
            solid: false,
            diggable: true,
            conjurable: false,
            toughness: None,
        ),

        // The floor of the world. Not diggable, so nothing can tunnel out the
        // bottom of the map.
        "bedrock": (
            swatch: Some("terrain/bedrock"),
            solid: true,
            diggable: false,
            conjurable: false,
            toughness: None,
        ),
    },
)

// What the world is made of.
//
// Each entry registers a substance that a voxel can use. Adding one here makes it
// available to the game, but terrain generation must select it before it appears
// in a generated world.
//
// `air` is special and must always be present: it means empty space, and the game
// checks for it constantly. The default generator also selects `bedrock`, `stone`,
// `dirt`, and `grass` by name; changing their properties is safe, but renaming
// them requires updating the generation code.
(
    substances: {
        "air": (
            // Never drawn. The colour is here only so the list has one shape.
            color: (0.0, 0.0, 0.0),
            // Nothing stands on air.
            solid: false,
            // There is nothing to dig out of it.
            diggable: false,
        ),

        "grass": (
            color: (0.35, 0.62, 0.30),
            solid: true,
            diggable: true,
        ),

        "dirt": (
            color: (0.45, 0.33, 0.22),
            solid: true,
            diggable: true,
        ),

        "stone": (
            color: (0.55, 0.55, 0.58),
            solid: true,
            diggable: true,
        ),

        // The floor of the world. Not diggable, so nothing can tunnel out the
        // bottom of the map.
        "bedrock": (
            color: (0.25, 0.24, 0.28),
            solid: true,
            diggable: false,
        ),
    },
)

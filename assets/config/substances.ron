// What the world is made of.
//
// Each entry registers a substance that a voxel can use. Adding one here makes it
// available to the game, but terrain generation must select it before it appears
// in a generated world.
//
// `air` is special and must always be present: it means empty space, and the game
// checks for it constantly. The terrain presets select the other entries by name;
// changing their properties is safe, but renaming them requires updating the
// generation code.
(
    substances: {
        "air": (
            // Never drawn. The colour is here only so the list has one shape.
            color: (0.0, 0.0, 0.0),
            // Nothing stands on air.
            solid: false,
            // There is nothing to dig out of it.
            diggable: false,
        ),

        "grass": (
            color: (0.35, 0.62, 0.30),
            solid: true,
            diggable: true,
        ),

        "dirt": (
            color: (0.45, 0.33, 0.22),
            solid: true,
            diggable: true,
        ),

        "stone": (
            color: (0.55, 0.55, 0.58),
            solid: true,
            diggable: true,
        ),

        "gravel": (
            color: (0.42, 0.40, 0.36),
            solid: true,
            diggable: true,
        ),

        // Rendered as a voxel but excluded from movement footing. It remains
        // clearable through the same terrain-edit rule as dirt and stone.
        "water": (
            color: (0.08, 0.32, 0.65),
            solid: false,
            diggable: true,
        ),

        // Durability is not modelled yet, so metal is currently just a solid,
        // diggable bridge material.
        "metal": (
            color: (0.30, 0.34, 0.40),
            solid: true,
            diggable: true,
        ),

        // Structural-probe materials for procedural environments. Their behaviour is
        // intentionally simple until temperature, slipping, and hazards exist.
        "snow": (
            color: (0.82, 0.88, 0.92),
            solid: true,
            diggable: true,
        ),

        "ice": (
            color: (0.42, 0.72, 0.88),
            solid: true,
            diggable: true,
        ),

        "basalt": (
            color: (0.20, 0.22, 0.24),
            solid: true,
            diggable: true,
        ),

        // Lava is an opaque, non-solid voxel for now. Damage and emissive rendering
        // need gameplay and material contracts that do not exist yet.
        "lava": (
            color: (0.90, 0.20, 0.04),
            solid: false,
            diggable: true,
        ),

        // The floor of the world. Not diggable, so nothing can tunnel out the
        // bottom of the map.
        "bedrock": (
            color: (0.25, 0.24, 0.28),
            solid: true,
            diggable: false,
        ),
    },
)

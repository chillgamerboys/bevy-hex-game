// A deterministic grass-to-desert ecotone with enough room to read all three
// material bands. The scenario owns the review seed.
(
    grid_radius: 12,
    level_height: 0.4,
    terrain: Procedural((
        generator_version: 3,
        layout: Single((
            environment: Arid,
            recipe: DesertTransition((
                base_level: 15,
                max_relief: 3,
                transition_width: 8,
                dry_coverage_percent: 55,
            )),
            overlays: [],
            mask: WholeWorld,
            edges: (
                east: WorldBoundary,
                south_east: WorldBoundary,
                south_west: WorldBoundary,
                west: WorldBoundary,
                north_west: WorldBoundary,
                north_east: WorldBoundary,
            ),
        )),
    )),
)

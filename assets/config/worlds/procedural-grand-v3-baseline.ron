// Grand V3 Baseline: compile the revision-3 radius-eight schematic into
// one continuous radius-187 voxel world. The dramatic vertical scale is frozen here
// so later palette, radius-to-height, and partial-voxel experiments can change their
// own axes without changing the accepted biome topology.
(
    grid_radius: 187,
    level_height: 0.35,
    terrain: Procedural((
        generator_version: 3,
        layout: Schematic((
            template: GrandV3,
            template_revision: 3,
            cell_pitch: 22,
            terrain_profile: GrandV3BasicV1((
                sea_level: 8,
                island_level: 12,
                beach_level: 10,
                shore_level: 12,
                valley_level: 16,
                plateau_level: 20,
                hill_level: 20,
                mountain_floor: 28,
                massif_floor: 48,
                high_core_level: 150,
                high_gradient_per_cell: 18,
                mountain_lake_level: 150,
                frozen_woods_level: 152,
                lake_island_min_level: 151,
                lake_island_max_level: 158,
                sharp_peak_bench_min: 150,
                sharp_peak_bench_max: 166,
                sharp_peak_min: 178,
                sharp_peak_max: 192,
                valley_lake_level: 15,
                crystal_base_level: 6,
                crystal_rise_levels: 144,
            )),
        )),
    )),
)

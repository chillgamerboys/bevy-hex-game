// Broad traversable dune ridges with exact one-level ordinary transitions.
// The scenario owns the review seed.
(
    grid_radius: 12,
    level_height: 0.4,
    terrain: Procedural((
        generator_version: 3,
        layout: Single((
            environment: Arid,
            recipe: Dunes((
                base_level: 15,
                ridge_height: 6,
                ridge_spacing: 12,
                ridge_count: 5,
            )),
            overlays: [],
            mask: WholeWorld,
            edges: (
                east: WorldBoundary,
                south_east: WorldBoundary,
                south_west: WorldBoundary,
                west: WorldBoundary,
                north_west: WorldBoundary,
                north_east: WorldBoundary,
            ),
        )),
    )),
)

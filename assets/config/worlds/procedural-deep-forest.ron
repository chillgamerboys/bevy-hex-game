// Dense rolling woodland using the three accepted authored tree forms.
// The seed lives on the scenario so review rerolls do not mutate this recipe.
(
    grid_radius: 12,
    level_height: 0.4,
    terrain: Procedural((
        generator_version: 3,
        layout: Single((
            environment: TemperateGrassland,
            recipe: DeepForest((
                base_level: 15,
                max_relief: 4,
                blocker_coverage_percent: 30,
                clearing_count: 3,
            )),
            overlays: [],
            mask: WholeWorld,
            edges: (
                east: WorldBoundary,
                south_east: WorldBoundary,
                south_west: WorldBoundary,
                west: WorldBoundary,
                north_west: WorldBoundary,
                north_east: WorldBoundary,
            ),
        )),
    )),
)

// Primary procedural review map. The seed lives on the scenario so a title-screen
// reroll can replace it for this session without mutating this recipe.
(
    grid_radius: 12,
    level_height: 0.4,
    terrain: Procedural((
        generator_version: 2,
        environment: TemperateGrassland,
        recipe: Hills((
            valley_level: 15,
            max_relief: 8,
            hills_per_bank: 3,
        )),
    )),
)

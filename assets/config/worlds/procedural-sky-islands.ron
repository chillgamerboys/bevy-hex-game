// Layered geometry probe. A finalized Hills map remains playable on the ground while
// a separately generated, flight-gated island network occupies the upper volume.
(
    grid_radius: 12,
    level_height: 0.4,
    terrain: Procedural((
        generator_version: 2,
        environment: TemperateGrassland,
        recipe: LayeredSkyIslands((
            ground: (
                valley_level: 15,
                max_relief: 8,
                hills_per_bank: 3,
            ),
            min_clearance: 8,
            upper_coverage_percent: 20,
        )),
    )),
)

// How the camera moves.
(
    // Reapplied whenever gameplay starts so the complete radius-12 map is visible.
    gameplay_eye: (0.0, 48.0, 42.0),
    gameplay_focus: (0.0, 6.0, 0.0),

    // Close third-person view around the selected character.
    character_focus_height: 0.4,
    character_radius: 7.0,
    // Terrain collision affects only Character mode. The camera snaps inward before
    // the closest public tile span, searches upward first and then toward the
    // horizon for low ceilings without changing player yaw, and restores pitch and
    // distance smoothly once the view clears. The sphere probe conservatively
    // protects the camera near plane around prism corners.
    character_probe_radius: 0.4,
    character_collision_margin: 0.35,
    character_min_effective_radius: 1.5,
    character_restoration_speed: 8.0,
    // Fraction from level with the horizon (0.0) to straight down (1.0).
    character_pitch: 0.3,
    // The close view can approach the horizon to inspect terrain above the unit.
    character_min_pitch: 0.05,
    character_max_pitch: 0.95,
    character_adaptive_max_pitch: 0.75,
    character_pitch_search_step: 0.05,
    character_pitch_restoration_speed: 0.8,

    // WASD pan speed. Scaled by how far out you are zoomed, so panning feels the
    // same at every distance.
    pan_speed: 0.4,
    // Added to the zoom distance before scaling pan speed, so panning still works
    // when fully zoomed in.
    pan_speed_offset: 10.0,

    // Map-view tilt limits, 0.0 (level with the horizon) to 1.0 (straight down).
    min_pitch: 0.25,
    max_pitch: 0.95,

    // Zoom limits, in world units.
    min_zoom: 5.0,
    max_zoom: 70.0,

    // Fraction of the current distance covered per scroll notch.
    zoom_sensitivity: 0.2,
)

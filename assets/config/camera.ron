// How the camera moves.
(
    // Reapplied whenever gameplay starts so the complete radius-12 map is visible.
    gameplay_eye: (0.0, 44.0, 38.0),
    gameplay_focus: (0.0, 6.0, 0.0),

    // Reapplied whenever the title screen is shown. Without a frame of its own the
    // menu inherited wherever the player had orbited to before quitting, so the same
    // screen appeared at a different angle every time.
    //
    // Nothing is rendered behind the menu except the sky, so this is really choosing
    // which part of the horizon to sit on. Low and level: the skybox is most
    // interesting near the horizon and least interesting straight up.
    menu_eye: (0.0, 12.0, 34.0),
    menu_focus: (0.0, 9.0, 0.0),

    // WASD pan speed. Scaled by how far out you are zoomed, so panning feels the
    // same at every distance.
    pan_speed: 0.4,
    // Added to the zoom distance before scaling pan speed, so panning still works
    // when fully zoomed in.
    pan_speed_offset: 10.0,

    // Tilt limits, 0.0 (level with the horizon) to 1.0 (straight down).
    min_pitch: 0.25,
    max_pitch: 0.95,

    // Zoom limits, in world units.
    min_zoom: 5.0,
    max_zoom: 60.0,

    // Fraction of the current distance covered per scroll notch.
    zoom_sensitivity: 0.2,
)

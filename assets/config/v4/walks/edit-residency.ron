// FIRST launch: new save directory, --focus 184,-88,30 --radius 16.
// The final checkpoint deliberately retains step mode for the resume script.
(
    schema_version: 1,
    id: "exact-edit-unload-reload-and-checkpoint",
    max_ticks: 12000,
    steps: [
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:1200),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:1200),
        SetStepMode(actor:"party/0",enabled:false),
        WaitChunk(coordinate:(q:11,r:-6),resident:true,max_ticks:1200),
        AssertVoxel(position:(column:(q:182,r:-88),level:30),material:Some("grass")),
        EditVoxel(position:(column:(q:182,r:-88),level:30),max_ticks:600),
        AssertVoxel(position:(column:(q:182,r:-88),level:30),material:None),
        AssertVoxel(position:(column:(q:182,r:-88),level:29),material:Some("soil")),
        Save(max_ticks:600),
        MoveTo(actor:"party/0",goal:(column:(q:220,r:-105),level:40)),
        WaitAt(actor:"party/0",position:(column:(q:220,r:-105),level:40),max_ticks:3000),
        MoveTo(actor:"party/0",goal:(column:(q:250,r:-120),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:250,r:-120),level:30),max_ticks:3000),
        // Chunk 11,-6 has q<=191, so it is at least 59 columns from A here.
        // B remains at q=375. Both retention radii are 16+32=48.
        WaitChunk(coordinate:(q:11,r:-6),resident:false,max_ticks:1200),
        AssertAt(actor:"party/1",position:(column:(q:375,r:-187),level:40)),
        MoveTo(actor:"party/0",goal:(column:(q:220,r:-105),level:40)),
        WaitAt(actor:"party/0",position:(column:(q:220,r:-105),level:40),max_ticks:3000),
        MoveTo(actor:"party/0",goal:(column:(q:184,r:-88),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:3000),
        WaitChunk(coordinate:(q:11,r:-6),resident:true,max_ticks:1200),
        AssertVoxel(position:(column:(q:182,r:-88),level:30),material:None),
        AssertVoxel(position:(column:(q:182,r:-88),level:29),material:Some("soil")),
        SetStepMode(actor:"party/0",enabled:true),
        Save(max_ticks:600),
    ],
)

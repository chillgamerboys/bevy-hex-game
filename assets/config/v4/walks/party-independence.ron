// two-regions or seven-regions; --focus 184,-88,30 --radius 16.
// A waits between two turn steps while distant B completes a continuous route.
(
    schema_version: 1,
    id: "separated-party-step-independence",
    max_ticks: 36000,
    steps: [
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:12000),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:12000),
        SetStepMode(actor:"party/0",enabled:true),
        SetStepMode(actor:"party/1",enabled:false),
        MoveTo(actor:"party/0",goal:(column:(q:186,r:-89),level:30)),
        MoveTo(actor:"party/1",goal:(column:(q:365,r:-182),level:40)),
        StepOnce(actor:"party/0"),
        WaitAt(actor:"party/0",position:(column:(q:185,r:-89),level:30),max_ticks:6000),
        WaitAt(actor:"party/1",position:(column:(q:365,r:-182),level:40),max_ticks:9000),
        // Its receipt must still show A at this support with one queued step.
        AssertAt(actor:"party/0",position:(column:(q:185,r:-89),level:30)),
        StepOnce(actor:"party/0"),
        WaitAt(actor:"party/0",position:(column:(q:186,r:-89),level:30),max_ticks:6000),
        MoveTo(actor:"party/1",goal:(column:(q:375,r:-187),level:40)),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:9000),
        SetStepMode(actor:"party/0",enabled:false),
        MoveTo(actor:"party/0",goal:(column:(q:184,r:-88),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:6000),
    ],
)

// two-regions; --focus 184,-88,30 --radius 16 --parties 2.
// Switch the detailed view between distant resident parties while both use
// ordinary movement. Completed captures must contain three render-origin rebases.
(
    schema_version: 1,
    id: "distant-party-view-rebase-and-return",
    max_ticks: 60000,
    steps: [
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:12000),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:12000),
        SelectActor(actor:"party/1"),
        MoveTo(actor:"party/1",goal:(column:(q:365,r:-182),level:40)),
        WaitAt(actor:"party/1",position:(column:(q:365,r:-182),level:40),max_ticks:9000),
        SelectActor(actor:"party/0"),
        MoveTo(actor:"party/0",goal:(column:(q:194,r:-93),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:194,r:-93),level:30),max_ticks:9000),
        SelectActor(actor:"party/1"),
        MoveTo(actor:"party/1",goal:(column:(q:375,r:-187),level:40)),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:9000),
        AssertAt(actor:"party/0",position:(column:(q:194,r:-93),level:30)),
    ],
)

// two-regions or seven-regions; --focus 184,-88,30 --radius 16.
// A crosses the authoring seam and the q=192 global chunk boundary, then
// reverses an accepted step while its interpolation is still in progress.
(
    schema_version: 1,
    id: "dry-seam-and-mid-step-reversal",
    max_ticks: 3600,
    steps: [
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:1200),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:1200),
        SetStepMode(actor:"party/0",enabled:false),
        MoveTo(actor:"party/0",goal:(column:(q:194,r:-93),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:194,r:-93),level:30),max_ticks:900),
        SetStepMode(actor:"party/0",enabled:true),
        MoveTo(actor:"party/0",goal:(column:(q:184,r:-88),level:30)),
        StepOnce(actor:"party/0"),
        // StepOnce begins the ordinary leg to (193,-93,30). The next update
        // queues a new goal while that leg is active; no support is assigned here.
        MoveTo(actor:"party/0",goal:(column:(q:200,r:-96),level:30)),
        SetStepMode(actor:"party/0",enabled:false),
        WaitAt(actor:"party/0",position:(column:(q:200,r:-96),level:30),max_ticks:900),
        MoveTo(actor:"party/0",goal:(column:(q:184,r:-88),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:900),
        AssertAt(actor:"party/1",position:(column:(q:375,r:-187),level:40)),
    ],
)

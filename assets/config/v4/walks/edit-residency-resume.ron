// SECOND process: reuse edit-residency's save directory; omit --focus.
// The first waits require restored actor positions. StepOnce requires the
// saved step mode without setting it here; exact air/soil prove the saved edit.
(
    schema_version: 1,
    id: "resume-exact-world-and-actor-checkpoint",
    max_ticks: 3600,
    steps: [
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:1200),
        WaitAt(actor:"party/1",position:(column:(q:375,r:-187),level:40),max_ticks:1200),
        WaitChunk(coordinate:(q:11,r:-6),resident:true,max_ticks:1200),
        AssertVoxel(position:(column:(q:182,r:-88),level:30),material:None),
        AssertVoxel(position:(column:(q:182,r:-88),level:29),material:Some("soil")),
        MoveTo(actor:"party/0",goal:(column:(q:186,r:-89),level:30)),
        StepOnce(actor:"party/0"),
        WaitAt(actor:"party/0",position:(column:(q:185,r:-89),level:30),max_ticks:600),
        StepOnce(actor:"party/0"),
        WaitAt(actor:"party/0",position:(column:(q:186,r:-89),level:30),max_ticks:600),
        SetStepMode(actor:"party/0",enabled:false),
        MoveTo(actor:"party/0",goal:(column:(q:184,r:-88),level:30)),
        WaitAt(actor:"party/0",position:(column:(q:184,r:-88),level:30),max_ticks:600),
        Save(max_ticks:600),
    ],
)

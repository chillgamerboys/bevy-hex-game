// The player piece.
(
    // The king mesh is 9.08 source units tall. At the shared 0.4 world-units per
    // voxel level, this renders at 1.88 levels: visibly just under the walker's
    // two-level clearance contract.
    scale: 0.083,

    // Movement speed in world units per second. A tile is about 1.76 units
    // across, so 5.0 crosses one in a little over a third of a second.
    speed: 5.0,

    color: (1.0, 0.2, 0.2),
)

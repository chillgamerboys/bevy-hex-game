// Sun, ambient light, and sky.
//
// These use real physical units. Illuminance is in lux: around 100000 is direct
// noon sun, 10000 is overcast.
(
    sun_illuminance: 10000.0,

    // Sun direction, as XYZ rotation in radians.
    sun_rotation: (11.4, 0.3, 0.0),

    // Fill light applied everywhere, so shadows are not pure black.
    ambient_brightness: 80.0,

    // Sky gradient: paler at the horizon, deeper blue overhead.
    sky_color: (0.55, 0.80, 0.95),
    zenith_color: (0.25, 0.50, 0.85),

    // Hexagonal clouds.
    cloud_color: (0.97, 0.98, 1.0),
    cloud_coverage: 0.4,
    hex_cloud_scale: 13.0,
    cloud_softness: 0.12,
)

    "crates/hex_game/Cargo.toml",
    "crates/hex_game/src/casting/preview.rs",
    "crates/hex_game/src/screens/creator.rs",
    "crates/hex_game/tests/spell_resolution.rs",
    "crates/hex_units/**",
    "docs/contracts.md",
    "docs/development/gameplay-testing.md",
    "docs/development/parallel-development.md",
    "docs/planning/roadmap.md",
    "docs/planning/spell-resolution-wave.md",
    "docs/planning/status.md",

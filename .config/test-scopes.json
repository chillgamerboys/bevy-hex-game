        "hex_combat::contracts loop_contract::adapter_spending_the_turn_advances_both_projections_in_the_same_frame",
        "hex_combat_core authority::tests::external_resolution_holds_turn_and_outcome_between_area_answers",
        "hex_core terrain_impact::tests::applied_outcome_rejects_every_volume_and_batch_mismatch",
        "hex_core terrain_impact::tests::applied_outcome_requires_the_exact_announced_order",

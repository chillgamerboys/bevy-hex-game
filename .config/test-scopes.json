{
  "version": 1,
  "all_concerns": [
    "selector",
    "rules",
    "trajectory_contracts",
    "spell_resolution_contracts",
    "contracts",
    "simulation",
    "app",
    "map_unit",
    "map_generation",
    "map_contracts",
    "residual",
    "clippy",
    "docs",
    "shipping"
  ],
  "local_test_order": [
    "selector",
    "rules",
    "trajectory_contracts",
    "spell_resolution_contracts",
    "contracts",
    "simulation",
    "app",
    "map_unit",
    "map_generation",
    "map_contracts",
    "residual"
  ],
  "concerns": {
    "selector": {
      "description": "Fail-closed scope routing and canonical-command validation.",
      "command": [
        "python3",
        "-m",
        "unittest",
        "tools/test_test_scope.py"
      ]
    },
    "rules": {
      "description": "Pure core, lattice, and AI rules.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_core",
        "--package",
        "hex_lattice",
        "--package",
        "hex_ai",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-rules"
      ],
      "root_packages": ["hex_core", "hex_lattice", "hex_ai"],
      "allowed_workspace_packages": ["hex_core", "hex_lattice", "hex_ai"]
    },
    "trajectory_contracts": {
      "description": "Pure trajectory/volume/creation rules and their direct non-UI AI, command, and casting consumers.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_units",
        "--package",
        "hex_combat",
        "--package",
        "hex_game",
        "--lib",
        "--test",
        "contracts",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-trajectory"
      ]
    },
    "spell_resolution_contracts": {
      "description": "Exact non-UI spell impact, area resolution, settlement, authority, and real terrain-protocol seams.",
      "preflight_command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_core",
        "--package",
        "hex_assets",
        "--package",
        "hex_units",
        "--package",
        "hex_combat_core",
        "--package",
        "hex_combat",
        "--lib",
        "--test",
        "contracts",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-spell-resolution"
      ],
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_map",
        "--test",
        "contracts",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-spell-resolution-map"
      ],
      "postflight_command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_game",
        "--lib",
        "--test",
        "spell_resolution",
        "--test",
        "game_content_contracts",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-spell-resolution-composition"
      ]
    },
    "contracts": {
      "description": "Focused gameplay ECS contracts.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_test_support",
        "--package",
        "hex_units",
        "--package",
        "hex_combat",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-contracts"
      ]
    },
    "simulation": {
      "description": "Deterministic multi-turn combat and CombatSummary snapshots.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_combat_core",
        "--lib",
        "--test",
        "simulation",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-simulation"
      ],
      "root_packages": ["hex_combat_core"],
      "allowed_workspace_packages": ["hex_combat_core", "hex_core", "hex_lattice"]
    },
    "app": {
      "description": "Headless Campaign, Sandbox, Creator, gameplay application, and UI behavior.",
      "preflight_command": [
        "cargo",
        "test",
        "--package",
        "hex_game",
        "--lib",
        "--no-run",
        "--profile",
        "ci"
      ],
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_gameplay_model",
        "--package",
        "hex_ui",
        "--package",
        "hex_game",
        "--features",
        "hex_game/test-support",
        "--lib",
        "--test",
        "gameplay_app",
        "--cargo-profile",
        "ci",
        "--profile",
        "gameplay-app"
      ],
      "postflight_command": [
        "cargo",
        "test",
        "--package",
        "hex_ui",
        "--lib",
        "--features",
        "test-support,dev-tools",
        "--profile",
        "ci",
        "dev_time::tests::"
      ]
    },
    "map_unit": {
      "description": "Map storage, settings, grid, and renderer-free publication units.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_map",
        "--lib",
        "--cargo-profile",
        "map-test",
        "--profile",
        "map-unit"
      ]
    },
    "map_generation": {
      "description": "Deterministic V1, V2, and V3 generation contracts and PR corpora.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_map",
        "--lib",
        "--cargo-profile",
        "map-test",
        "--profile",
        "map-generation"
      ]
    },
    "map_contracts": {
      "description": "Headless map publication, edit, presentation, and lifecycle contracts.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--package",
        "hex_map",
        "--test",
        "contracts",
        "--cargo-profile",
        "map-test",
        "--profile",
        "map-contracts"
      ]
    },
    "residual": {
      "description": "All remaining non-map workspace and cross-owner contract tests.",
      "command": [
        "cargo",
        "nextest",
        "run",
        "--workspace",
        "--all-features",
        "--cargo-profile",
        "ci",
        "--profile",
        "ci",
        "-E",
        "not (package(hex_core) | package(hex_lattice) | package(hex_ai) | package(hex_units) | package(hex_combat_core) | package(hex_combat) | package(hex_test_support) | package(hex_gameplay_model) | package(hex_ui) | package(hex_map) | (package(hex_game) & binary(gameplay_app)))"
      ]
    },
    "clippy": {
      "description": "Strict workspace lint contract.",
      "command": [
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--profile",
        "ci",
        "--",
        "-D",
        "warnings"
      ]
    },
    "docs": {
      "description": "Warnings-denied workspace documentation.",
      "environment": {
        "RUSTDOCFLAGS": "-D warnings"
      },
      "command": [
        "cargo",
        "doc",
        "--workspace",
        "--no-deps",
        "--all-features"
      ]
    },
    "shipping": {
      "description": "Default-feature shipping package.",
      "command": [
        "cargo",
        "build",
        "--package",
        "hex_game",
        "--release"
      ]
    }
  },
  "partition_checks": {
    "map": {
      "concerns": ["map_unit", "map_generation", "map_contracts"],
      "expected_counts": {
        "map_unit": 99,
        "map_generation": 388,
        "map_contracts": 80
      },
      "expected_ignored": 28,
      "full_command": [
        "cargo",
        "nextest",
        "list",
        "--package",
        "hex_map",
        "--cargo-profile",
        "map-test"
      ],
      "all_tests_command": [
        "cargo",
        "test",
        "--package",
        "hex_map",
        "--all-features",
        "--profile",
        "map-test",
        "--",
        "--list"
      ]
    }
  },
  "selection_checks": {
    "spell_resolution_contracts": {
      "preflight_command": [
        "hex_assets content_index::tests::a_dangling_impact_element_fails_cross_file_admission",
        "hex_assets lattices::tests::area_disable_burn_and_impact_are_admitted_to_lattices",
        "hex_assets lattices::tests::area_restore_reveal_and_targeted_disable_remain_fail_closed",
        "hex_assets spells::tests::impact_rejects_blank_elements_and_zero_power_before_indexing",
        "hex_assets spells::tests::impact_round_trips_reflects_and_has_complete_fingerprint_fields",
        "hex_assets spells::tests::shipped_fireball_announces_fire_impact_without_deferred_displacement",
        "hex_assets spells::tests::shipped_spells_cover_every_advertised_effect_variant",
        "hex_assets spells::tests::shipped_spells_parse",
        "hex_combat commands::cast::tests::ai_and_authority_share_public_construction_admission",
        "hex_combat commands::cast::tests::redundant_spell_resolution_prefers_a_live_copy",
        "hex_combat commands::tests::a_disable_decision_is_modal_for_every_other_command",
        "hex_combat resolution::tests::a_retained_outcome_blocks_pausable_simulation",
        "hex_combat resolution::tests::simultaneous_elimination_is_defeat",
        "hex_combat resolution::tests::terminal_outcome_emits_once",
        "hex_combat spell_resolution::tests::each_late_applied_batch_invalidates_an_older_settlement_adoption",
        "hex_combat spell_resolution::tests::foreign_and_structurally_inconsistent_outcomes_retain_evidence",
        "hex_combat spell_resolution::tests::terrain_batches_are_monotonic_and_release_only_after_every_answer",
        "hex_combat spell_resolution::tests::unit_work_is_fifo_and_session_reset_restarts_the_allocator",
        "hex_combat spell_resolution::tests::valid_unavailable_rejection_completes_but_reused_and_duplicate_freeze",
        "hex_combat::contracts damage::a_disable_decision_is_answered_through_the_command_log",
        "hex_combat::contracts damage::a_mismatched_answer_is_refused",
        "hex_combat::contracts effects::a_damage_cast_on_a_downed_unit_is_refused_before_payment",
        "hex_combat::contracts effects::an_earthen_wall_publishes_two_complete_voxels_above_the_selected_surface",

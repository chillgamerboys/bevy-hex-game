        "hex_core terrain_impact::tests::structural_rejections_are_exact",
        "hex_core terrain_impact::tests::structurally_rejected_impacts_never_accept_applied_answers",
        "hex_core terrain_impact::tests::voxel_outcome_validation_exhausts_material_and_health_semantics",
        "hex_units terrain_occupancy::tests::authorized_occupancy_contains_only_explicit_observed_surface_voxels",
        "hex_units terrain_occupancy::tests::downstream_actor_sees_same_frame_addition_and_removal",

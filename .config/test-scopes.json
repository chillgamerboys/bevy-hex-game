        "hex_game::spell_resolution applied_impact_rebuilds_occupancy_settles_the_actor_and_releases_exact_authority",
        "hex_game::spell_resolution foreign_answer_freezes_and_an_outstanding_defender_answer_cannot_mutate",
        "hex_game::spell_resolution reversed_multi_batch_answers_and_a_later_cast_never_reuse_settlement_adoption",
        "hex_game::spell_resolution terrain_release_precedes_end_turn_and_the_next_actors_start_effect",

// Current README captures: one Creator workspace and one Sandbox deployment on
// production terrain. Tools-origin Creator routing deliberately returns to Tools.
[
    AwaitScreen("Title"),
    Settle(45),
    Click(name: "Tools"),
    AwaitButton("Character Creator"),
    Click(name: "Character Creator"),
    AwaitScreen("CharacterCreator"),
    Settle(20),
    Click(name: "Wolf Template"),
    Settle(20),
    Capture("character-creator"),
    Click(name: "Discard Changes"),
    Settle(3),
    Click(name: "Library"),
    Settle(5),
    Click(name: "Back to Tools"),
    AwaitScreen("Title"),
    AwaitButton("Back"),
    Click(name: "Back"),
    AwaitButton("Sandbox"),
    Click(name: "Sandbox"),
    AwaitScreen("Sandbox"),
    AwaitButton("Choose Sandbox map"),
    Click(name: "Choose Sandbox map"),
    AwaitButton("Inspect Fort"),
    Click(name: "Inspect Fort"),
    AwaitButton("Use Map"),
    Settle(20),
    Click(name: "Use Map"),
    AwaitButton("Start Sandbox"),
    Click(name: "Start Sandbox"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    // Guided deployment consumes ordinary exact terrain clicks. These two
    // surfaces are seed-exact Fort review points outside any UI adapter.
    ClickTile(q: 8, r: -4, level: Some(15)),
    ClickTile(q: 0, r: 0, level: Some(15)),
    AwaitButton("Start Combat"),
    Settle(30),
    Capture("sandbox-deployment"),
]

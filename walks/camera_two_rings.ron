// Group one of five real ordinary-network traversals covering all nineteen regions:
// the central confluence, Waterfall B, and the Mountains A handoff. This script does
// not teleport or suppress combat.
[
    AwaitScreen("Title"),
    StartScenario(name: "Two Rings", seed: Some(1592598566)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    Key("C"),
    Settle(60),
    Capture("01-two-rings-center-start"),
    ClickAnchor(name: "confluence_overlook", expected: (q: 0, r: 0, level: 18)),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: 0, r: 0, level: 18)),
    Settle(60),
    Capture("02-two-rings-confluence-front"),
    OrbitCamera(yaw_turns: 0.33333334),
    Settle(45),
    Capture("03-two-rings-confluence-side"),
    ClickAnchor(name: "waterfall_b_fall_overlook", expected: (q: -24, r: 4, level: 26)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -24, r: 4, level: 26)),
    Settle(60),
    Capture("04-two-rings-waterfall-b-front"),
    OrbitCamera(yaw_turns: -0.33333334),
    Settle(45),
    Capture("05-two-rings-waterfall-b-side"),
    ClickAnchor(name: "mountain_waterfall_overlook", expected: (q: -24, r: -13, level: 20)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -24, r: -13, level: 20)),
    Settle(60),
    Capture("06-two-rings-mountains-a-front"),
    OrbitCamera(yaw_turns: 0.33333334),
    Settle(45),
    Capture("07-two-rings-mountains-a-side"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

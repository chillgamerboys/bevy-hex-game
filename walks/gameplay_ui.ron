// Ten deterministic Bevy image-target frames for the shipping application shell.
// Every ReviewCapture first runs the named UiTaskCase structural oracle; pixels
// remain presentation evidence only. Nine distinct frames cover each cutover route;
// frame 09 repeats the character picker at 4K/200% as the single targeted responsive
// duplicate.
[
    AwaitScreen("Title"),
    SetViewport(width: 1920, height: 1080, device_scale: 1.0),
    SetUiScale(Auto),
    Settle(8),
    ReviewCapture(name: "ui-01-main-menu", task: MainMenu),

    Click(name: "Campaign"),
    AwaitButton("Back"),
    Settle(4),
    ReviewCapture(name: "ui-02-campaign", task: Campaign),
    Click(name: "Back"),
    AwaitButton("Sandbox"),

    Click(name: "Sandbox"),
    AwaitScreen("Sandbox"),
    AwaitButton("Choose Sandbox map"),
    Settle(4),
    ReviewCapture(name: "ui-03-sandbox-overview", task: SandboxOverview),

    Click(name: "Choose Sandbox map"),
    AwaitButton("Inspect Flat Arena"),
    Settle(4),
    ReviewCapture(name: "ui-04-map-selector", task: SandboxMapBrowser),
    Click(name: "Inspect Flat Arena"),
    AwaitButton("Use Map"),
    Settle(4),
    ReviewCapture(name: "ui-05-map-confirmation", task: SandboxMapDetail),
    Click(name: "Use Map"),
    AwaitButton("Choose Party characters"),

    Click(name: "Choose Party characters"),
    AwaitButton("Party slot 1"),
    Settle(4),
    ReviewCapture(name: "ui-06-party", task: SandboxParty),
    Click(name: "Back"),
    AwaitButton("Choose Enemies characters"),

    Click(name: "Choose Enemies characters"),
    AwaitButton("Enemies slot 1"),
    Settle(4),
    ReviewCapture(name: "ui-07-enemies", task: SandboxEnemies),
    Click(name: "Enemies slot 1"),
    AwaitButton("Preview Hedge Mage"),
    Click(name: "Preview Hedge Mage"),
    AwaitButton("Use Character"),
    Settle(4),
    ReviewCapture(
        name: "ui-08-character-selector",
        task: SandboxCharacterPicker,
    ),

    SetViewport(width: 3840, height: 2160, device_scale: 1.0),
    SetUiScale(Percent200),
    Settle(6),
    ReviewCapture(
        name: "ui-09-character-selector-4k-200",
        task: SandboxCharacterPicker,
    ),

    SetViewport(width: 1920, height: 1080, device_scale: 1.0),
    SetUiScale(Auto),
    Click(name: "Back"),
    AwaitButton("Enemies slot 1"),
    Click(name: "Back"),
    AwaitButton("Choose Sandbox map"),
    Click(name: "Back"),
    AwaitScreen("Title"),
    AwaitButton("Tools"),
    Click(name: "Tools"),
    AwaitButton("Character Creator"),
    Settle(4),
    ReviewCapture(name: "ui-10-tools", task: Tools),
]

// The sole gameplay-owned screenshot acceptance route.
//
// Every capture answers a presentation question only: hierarchy, legibility,
// responsive composition, focus, or overlap. Rules, decisions, combat effects,
// persistence, exact deployment, and report identity use typed state snapshots.
[
    AwaitScreen("Title"),
    Settle(8),
    Capture("ui-01-title"),

    Click(name: "Settings"),
    AwaitScreen("Settings"),
    Settle(4),
    Capture("ui-02-settings"),
    Click(name: "Back"),

    AwaitScreen("Title"),
    Click(name: "Character Creator"),
    AwaitScreen("CharacterCreator"),
    Settle(4),
    Capture("ui-03-character-creator"),
    Click(name: "Title"),

    AwaitScreen("Title"),
    Click(name: "Spell Creator"),
    AwaitScreen("SpellCreator"),
    Settle(4),

// The sole gameplay-owned screenshot acceptance route.
//
// Every capture answers a presentation question only: hierarchy, legibility,
// responsive composition, focus, or overlap. Rules, decisions, combat effects,
// persistence, exact deployment, and report identity use typed state snapshots.
[
    AwaitScreen("Title"),
    Settle(8),
    Capture("ui-01-title"),

    Click(name: "Settings"),
    AwaitScreen("Settings"),
    Settle(4),
    Capture("ui-02-settings"),
    Click(name: "Back"),

    AwaitScreen("Title"),
    Click(name: "Character Creator"),
    AwaitScreen("CharacterCreator"),
    Click(name: "New Blank Character"),
    Settle(4),
    Capture("ui-03-creator-validation"),
    Click(name: "Discard Changes"),
    Click(name: "Library"),
    Click(name: "Title"),

    AwaitScreen("Title"),
    Click(name: "Combat Lab"),
    AwaitScreen("CombatLab"),
    Settle(4),
    Capture("ui-04-combat-lab-setup"),
    Click(name: "Continue to Rosters"),
    Click(name: "Continue to Rules"),
    Click(name: "Load Map & Deploy"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(6),
    Capture("ui-05-deployment"),
    Click(name: "Deterministic Auto-place"),
    Click(name: "Start Combat"),
    PresentUi("normal-gameplay"),
    Settle(6),
    Capture("ui-06-live-action-rail"),

    SetUiScale("200%"),
    PresentUi("required-decision"),
    Settle(4),
    Capture("ui-07-required-decision-200"),

    SetUiScale("Auto"),
    PresentUi("aiming-disabled"),
    Settle(4),
    Capture("ui-08-aiming-disabled"),

    PresentUi("live-statistics"),
    Settle(4),
    Capture("ui-09-live-statistics"),

    PresentUi("dense-report-compare"),
    Settle(4),
    Capture("ui-10-dense-report-compare"),
]

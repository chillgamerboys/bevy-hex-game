// Whole-map silhouette review followed by one proved ordinary-walker route from
// the central Shore to the landward Deep Mountain base. The rear view is an
// orbit of the generated terrain; it does not rely on a playable rear shelf.
[
    AwaitScreen("Title"),
    StartScenario(name: "Mountain Range", seed: Some(129704046)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    Settle(60),
    Capture("01-mountain-range-front-massif"),
    OrbitCamera(yaw_turns: 0.5),
    Settle(60),
    Capture("02-mountain-range-rear-silhouette"),
    OrbitCamera(yaw_turns: -0.5),
    Settle(45),
    Key("C"),
    ClickAnchor(name: "coast_review", expected: (q: -52, r: 25, level: 12)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: -52, r: 25, level: 12)),
    Settle(60),
    Capture("03-mountain-range-coast"),
    ClickAnchor(name: "inland_review", expected: (q: -9, r: 14, level: 20)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -9, r: 14, level: 20)),
    Settle(60),
    Capture("04-mountain-range-watershed"),
    ClickAnchor(name: "foothill_review", expected: (q: -8, r: 13, level: 20)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: -8, r: 13, level: 20)),
    Settle(60),
    Capture("05-mountain-range-foothills"),
    ClickAnchor(name: "massif_front_review", expected: (q: 31, r: 5, level: 34)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 31, r: 5, level: 34)),
    Settle(60),
    Capture("06-mountain-range-mountain-tiers-front"),
    ClickAnchor(name: "deep_mountain_base", expected: (q: 53, r: 5, level: 48)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 53, r: 5, level: 48)),
    Settle(60),
    Capture("07-mountain-range-deep-mountain-base"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

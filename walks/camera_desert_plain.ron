    Settle(60),
    Capture("01-desert-plain-relief-map"),
    ClickTile(q: -8, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -8, r: 0, level: 15)),
    ClickTile(q: -4, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -4, r: 0, level: 15)),
    ClickTile(q: 0, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: 0, r: 0, level: 15)),
    ClickTile(q: 4, r: -2, level: Some(16)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),

// The gameplay walk: both scenario families, the pause overlay, and the
// return trip. Complements walks/menus.ron; run the same way. The long
// settles after AwaitTerrain mirror the map-review harness's frame budget so
// the camera and lighting have settled before the photograph.
[
    AwaitScreen("Title"),
    StartScenario(name: "The Crossing"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("10-crossing"),
    Key("Backspace"),
    AwaitScreen("Title"),
    Settle(30),
    StartScenario(name: "Procedural Hills"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("11-hills"),
    Key("Escape"),
    Settle(10),
    Capture("12-hills-paused"),
    Key("Escape"),
    Settle(10),
    Key("Backspace"),
    AwaitScreen("Title"),
    // Close Quarters spawns the pieces within engagement range, so this leg
    // photographs the combat loop through the command funnel: the fight is
    // already on in the first frame, SPACE ends the player's turn as an
    // emitted command, and the enemy answers with its own — a strike, since
    // it spawns adjacent.
    Settle(30),
    StartScenario(name: "Close Quarters"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("13-close-quarters-combat"),
    // The wave's proof, in two halves.
    //
    // `1` casts the acting unit's first *damaging* inscribed spell at the nearest
    // hostile — a placeholder emitter until the casting UX lands. Frame 14 cannot show
    // that damage: the HUD counts your own party's hexes, and nothing draws a hostile
    // lattice yet, so the cast's effect is in the log rather than on screen.
    //
    // Frame 15 is where damage becomes visible, and it is the enemy's doing: its strike
    // takes one of *your* hexes, and the readout falls. Both halves matter — one proves
    // a cast resolves, the other proves damage lands somewhere a player can see.
    Key("Digit1"),
    Settle(120),
    Capture("14-close-quarters-after-cast"),
    Key("Space"),
    Settle(90),
    Capture("15-close-quarters-enemy-turn"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

// The app-shell and exploration-continuity walk. Focused spell and identity behavior
// lives in ability_lab.ron and raider_mirror.ron; Party Trial remains the integrated
// human combat walk.
[
    AwaitScreen("Title"),
    Settle(45),
    Capture("10-app-shell"),

    // The default game is deliberately not a visible scenario card.
    Click(name: "New Game"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("11-new-game-party-trial"),

    // Saving is explicit and only accepted from paused, quiescent exploration.
    Key("Escape"),
    Settle(10),
    Capture("12-exploration-paused"),
    Key("F5"),
    Settle(20),
    Capture("13-resume-saved"),
    Key("Backspace"),
    AwaitScreen("Title"),
    Settle(30),
    Capture("14-continue-available"),

    Click(name: "Continue"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("15-exploration-restored"),
]

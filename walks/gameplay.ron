// The gameplay walk: both scenario families, the pause overlay, the casting
// interface, and the return trip. Complements walks/menus.ron; run the same way.
// The long settles after AwaitTerrain mirror the map-review harness's frame
// budget so the camera and lighting have settled before the photograph.
[
    AwaitScreen("Title"),
    StartScenario(name: "The Crossing"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("10-crossing"),
    Key("Backspace"),
    AwaitScreen("Title"),
    Settle(30),
    StartScenario(name: "Procedural Hills"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("11-hills"),
    Key("Escape"),
    Settle(10),
    Capture("12-hills-paused"),
    Key("Escape"),
    Settle(10),
    Key("Backspace"),
    AwaitScreen("Title"),
    // Close Quarters spawns the pieces within engagement range, so this leg
    // photographs the combat loop through the command funnel: the fight is
    // already on in the first frame, SPACE ends the player's turn as an
    // emitted command, and the enemy answers with its own — a strike, since
    // it spawns adjacent.
    Settle(30),
    StartScenario(name: "Close Quarters"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("13-close-quarters-combat"),
    // The wave's proof, in four frames.
    //
    // Every `Click` here is also an assertion. The runner waits for a button whose
    // `Name` starts with the given string and fails the whole walk if it never
    // appears, so "Cast Ember" existing means the panel found the hedge-mage's
    // lattice, asked `castable`, and offered the spell — and "Confirm Cast"
    // existing means aiming actually started.
    Click(name: "Cast Ember"),
    Settle(30),
    Capture("14-close-quarters-aiming"),
    // Cycle to the next unit in range, then put the spell down again. With one
    // hostile on the board the cycle lands back where it started; what frame 15
    // shows is the preview *gone*, which is the half of aiming that has no other
    // way of being checked.
    Key("Tab"),
    Settle(10),
    Key("KeyQ"),
    Settle(20),
    Capture("15-close-quarters-aim-cancelled"),
    Click(name: "Cast Ember"),
    Settle(30),
    Click(name: "Confirm Cast"),
    Settle(120),
    // Frame 16 is the applier answering: the panel's rows lose their buttons and
    // say the action is spent, which only happens if the cast was accepted. The
    // damage itself is still not on screen — the HUD counts your own party's hexes
    // and nothing draws a hostile lattice — so the interface is the witness.
    Capture("16-close-quarters-after-cast"),
    // And frame 17 is where damage becomes visible, by the enemy's doing: its
    // strike takes one of *your* hexes and the party readout falls.
    Key("Space"),
    Settle(90),
    Capture("17-close-quarters-enemy-turn"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

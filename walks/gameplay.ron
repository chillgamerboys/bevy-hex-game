// The gameplay walk: both scenario families, the pause overlay, and the
// return trip. Complements walks/menus.ron; run the same way. The long
// settles after AwaitTerrain mirror the map-review harness's frame budget so
// the camera and lighting have settled before the photograph.
[
    AwaitScreen("Title"),
    StartScenario(name: "The Crossing"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("10-crossing"),
    Key("Backspace"),
    AwaitScreen("Title"),
    Settle(30),
    StartScenario(name: "Procedural Hills"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("11-hills"),
    Key("Escape"),
    Settle(10),
    Capture("12-hills-paused"),
    Key("Escape"),
    Settle(10),
    Key("Backspace"),
    AwaitScreen("Title"),
    // Close Quarters spawns the pieces within engagement range, so this leg
    // photographs the combat loop through the command funnel: the fight is
    // already on in the first frame, SPACE ends the player's turn as an
    // emitted command, and the enemy answers with its own — a strike, since
    // it spawns adjacent.
    Settle(30),
    StartScenario(name: "Close Quarters"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    Capture("13-close-quarters-combat"),
    // The wave's proof. `1` casts the acting unit's first inscribed spell at the
    // nearest hostile — a placeholder emitter until the casting UX lands — and the
    // frame after it should show the HUD's hex count fall, because a landed cast
    // parks a disable decision that the auto-policy answers on the next tick.
    //
    // Photographing damage is the point: the count is the only thing on screen that
    // says a spell did anything, and a cast that silently does nothing looks exactly
    // like one that worked.
    Key("Digit1"),
    Settle(120),
    Capture("14-close-quarters-after-cast"),
    Key("Space"),
    Settle(90),
    Capture("15-close-quarters-enemy-turn"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

// Real ordinary-network traversal from the central oasis through an inner dune,
// an outer dune, and the neighboring open-desert region. The opening Map frame
// remains centered on the seed-pinned oasis overview.
[
    AwaitScreen("Title"),
    StartScenario(name: "Desert Oasis Rings", seed: Some(1592598566), suppress_hostiles: true),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(45),

    ClickTile(q: -9, r: 3, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -9, r: 3, level: 15)),
    ClickAnchor(name: "oasis_overlook", expected: (q: -6, r: 0, level: 15)),

// Ordinary gameplay-camera proof for the complete Grand V3 Baseline world.
//
// This route will follow one explorer from the coastal lowlands through both
// river bridges and the natural upper pass, then return through the Dark tunnel
// and climb Crystal Ascent. Every review stop records the opaque Map context and
// both close character-camera perspectives.
//
// The visual-walk schema deliberately cannot install diagnostic presentation
// overrides. The companion illumination-overlay and full-interior-cutaway frames
// must therefore remain separate `map-review` launches focused on the stable
// `grand_v3.tunnel_midpoint` or Crystal interior anchors; ordinary gameplay
// captures below prove that neither override leaks into the shipped camera path.
// The approval pack should additionally launch `map-review` twice at
// `grand_v3.tunnel_midpoint`: once with `HEX_REVIEW_ILLUMINATION=overlay`, and
// once with `HEX_REVIEW_VIEW=top-down` plus `HEX_REVIEW_CUTAWAY=full`.
//
// Pinned itinerary for seed 1_592_598_566. Each stop receives Map, Character,
// and First Person evidence behind an exact stale-evidence TilePos. The shipped
// `party_start` is the same surface as `grand_v3.coast`, so it is proved once:
// `grand_v3.coast`, `grand_v3.archipelago`,
// `grand_v3.coastal_bridge`, `grand_v3.valley_bridge`,
// `grand_v3.valley_lake`, `grand_v3.natural_pass`,
// `grand_v3.massif`, `grand_v3.peak_saddle`,
// `grand_v3.mountain_lake`, `grand_v3.frozen_woods`,
// `grand_v3.tunnel_mouth`, `grand_v3.tunnel_midpoint`,
// `grand_v3.gothic_transition`, `grand_v3.ascent_threshold`,
// `crystal_ascent.bottom_chamber`, `crystal_ascent.mid_flight`, and
// `crystal_ascent.upper_exit`.
[
    AwaitScreen("Title"),
    StartScenario(name: "Grand V3 Baseline", seed: Some(1592598566)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(120),
    Capture("01-grand-v3-complete-opaque-world-map"),

    // The shipped party starts at the exact coast/outlet anchor. Prove that
    // initial projection before accepting any local camera evidence.
    AssertSelectedAt(expected: (q: -21, r: 99, level: 10)),
    Settle(45),
    Capture("02-grand-v3-coast-outlet-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.16666667, pitch_fraction: -0.08),
    Settle(45),
    Capture("03-grand-v3-coast-outlet-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("04-grand-v3-coast-outlet-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    // The remaining world route follows one explorer. This keeps the visual
    // inspection focused on terrain and avoids turning every long, narrow
    // landmark leg into a three-member formation-routing benchmark.
    Key("F"),
    AwaitButton("Party Movement Mode"),
    Click(name: "Party Movement Mode"),
    Key("Escape"),

    ClickAnchor(name: "grand_v3.archipelago", expected: (q: -75, r: 125, level: 10)),
    Settle(5),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: -75, r: 125, level: 10)),
    Settle(45),
    Capture("05-grand-v3-archipelago-overlook-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.16666667, pitch_fraction: 0.08),
    Settle(45),
    Capture("06-grand-v3-archipelago-overlook-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("07-grand-v3-archipelago-overlook-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "grand_v3.coastal_bridge", expected: (q: -5, r: 91, level: 10)),
    Settle(5),
    AwaitPartyIdle(max_frames: 12000),

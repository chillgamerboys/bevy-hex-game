// README-only capture of the integrated New Game scenario reaching 3v3 combat.
// Focused combat coverage lives in typed rules, contracts, simulation, and app
// snapshots; this script exists only to keep the public screenshot reproducible.
[
    AwaitScreen("Title"),
    StartScenario(name: "Party Trial"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(120),
    // One atomic formation route reaches the combat threshold deterministically.
    // Intermediate preset swaps belong to the focused formation fixtures, not this
    // public screenshot walk.
    Key("F"),
    Settle(4),
    Click(name: "Formation Preset Column"),
    Settle(8),
    Key("Escape"),
    Settle(4),
    ClickTile(q: 0, r: -4),
    AwaitPartyIdle(max_frames: 600),
    AwaitButton("Cast"),
    Settle(30),
    Capture("party-trial-combat"),
]

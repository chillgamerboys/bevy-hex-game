// Ordinary gameplay-camera proof for the complete Crystal Mountain route.
//
// The opaque Map frames establish the enclosing massif. The close-camera frames
// then follow one explorer from the exterior apron through the natural tunnel,
// Gothic transition, Crystal Ascent, summit oculus, and wooded basin. Each named
// route stop records the opaque Map context and both character-camera
// perspectives. Diagnostic cutaway and illumination-overlay captures remain
// separate map-review launches.
[
    AwaitScreen("Title"),
    StartScenario(name: "Crystal Mountain", seed: Some(1592598566)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(60),
    Capture("01-crystal-mountain-opaque-massif-map"),
    OrbitCamera(yaw_turns: 0.5),
    Settle(60),
    Capture("02-crystal-mountain-rear-ridge-basin-map"),
    OrbitCamera(yaw_turns: -0.5),

    AssertSelectedAt(expected: (q: -77, r: 3, level: 6)),
    Settle(45),
    Capture("03-crystal-mountain-foot-portal-map"),
    Key("C"),
    AssertCameraMode(Character),
    // Face inward toward the tunnel. A six-direction native-camera sweep fixes
    // this exact yaw; the opposite sign looks out over the radius-77 world edge.
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: 0.0),
    Settle(60),
    Capture("04-crystal-mountain-foot-portal-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("05-crystal-mountain-foot-portal-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_mountain.tunnel_mouth", expected: (q: -76, r: 1, level: 6)),
    Settle(5),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: -76, r: 1, level: 6)),

    // Enter the mouth once in the shipped default Group mode, proving the
    // fresh Compact footprint can compress through the four-wide portal. The
    // long vertical traversal then follows one selected explorer so this camera
    // proof does not become a formation-routing benchmark at every contraction.
    Key("F"),
    AwaitButton("Party Movement Mode"),
    Click(name: "Party Movement Mode"),
    Key("Escape"),

    ClickAnchor(name: "crystal_mountain.midpoint", expected: (q: -48, r: -1, level: 6)),
    Settle(5),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -48, r: -1, level: 6)),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: 0.0),
    Settle(45),
    Capture("06-crystal-mountain-natural-tunnel-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: -0.3),
    Settle(45),
    Capture("07-crystal-mountain-natural-tunnel-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(60),
    Capture("08-crystal-mountain-natural-tunnel-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_mountain.gothic_transition", expected: (q: -29, r: -15, level: 6)),
    Settle(5),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -29, r: -15, level: 6)),
    OrbitCamera(yaw_turns: -0.25, pitch_fraction: 0.0),
    Settle(45),
    Capture("09-crystal-mountain-gothic-transition-map"),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("10-crystal-mountain-gothic-transition-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: -0.08),
    Settle(60),
    Capture("11-crystal-mountain-gothic-transition-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_mountain.ascent_threshold", expected: (q: -17, r: -15, level: 6)),
    Settle(5),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: -17, r: -15, level: 6)),

    // Stress the exact authored landmark base before entering the chamber. This
    // character-height seam view catches an unfounded stair annulus.
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: -0.12),
    Settle(60),
    Capture("12-crystal-mountain-ascent-base-plinth-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("13-crystal-mountain-ascent-base-plinth-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_ascent.bottom_chamber", expected: (q: -8, r: -8, level: 6)),
    Settle(5),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: -8, r: -8, level: 6)),
    Settle(45),
    Capture("14-crystal-mountain-crystal-chamber-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: -0.08),
    Settle(45),
    Capture("15-crystal-mountain-crystal-chamber-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("16-crystal-mountain-crystal-chamber-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_ascent.mid_flight", expected: (q: 22, r: 0, level: 74)),
    Settle(5),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 22, r: 0, level: 74)),
    OrbitCamera(yaw_turns: -0.16666667, pitch_fraction: 0.0),
    Settle(45),
    Capture("17-crystal-mountain-mid-ascent-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: -0.18),
    Settle(45),
    Capture("18-crystal-mountain-mid-ascent-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    OrbitCamera(yaw_turns: 0.16666667, pitch_fraction: -0.08),
    Settle(45),
    Capture("19-crystal-mountain-mid-ascent-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_mountain.summit_exit", expected: (q: 16, r: 15, level: 150)),
    Settle(5),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 16, r: 15, level: 150)),
    OrbitCamera(yaw_turns: 0.16666667, pitch_fraction: 0.0),
    Settle(45),
    Capture("20-crystal-mountain-summit-exit-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: -0.08),
    Settle(45),
    Capture("21-crystal-mountain-summit-exit-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("22-crystal-mountain-summit-exit-first-person"),
    Key("C"),
    AssertCameraMode(Map),

    ClickAnchor(name: "crystal_mountain.basin_clearing", expected: (q: 15, r: 20, level: 150)),
    Settle(5),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: 15, r: 20, level: 150)),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: 0.0),
    Settle(45),
    Capture("23-crystal-mountain-wooded-basin-map"),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.5, pitch_fraction: -0.15),
    Settle(45),
    Capture("24-crystal-mountain-wooded-basin-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("25-crystal-mountain-wooded-basin-first-person"),
    Key("C"),
    AssertCameraMode(Map),
    Settle(5),
    Key("Backspace"),
    AwaitScreen("Title"),
]

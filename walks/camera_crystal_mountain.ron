// Ordinary gameplay-camera proof for the complete Crystal Mountain route.
//
// The opaque Map frames establish the enclosing massif. The close-camera frames
// then follow one explorer from the exterior apron through the natural tunnel,
// Gothic transition, Crystal Ascent, summit oculus, and wooded basin. Diagnostic
// cutaway and illumination-overlay captures remain separate map-review launches.
[
    AwaitScreen("Title"),
    StartScenario(name: "Crystal Mountain", seed: Some(1592598566)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(60),
    Capture("01-crystal-mountain-opaque-massif-map"),
    OrbitCamera(yaw_turns: 0.5),
    Settle(60),
    Capture("02-crystal-mountain-rear-ridge-basin-map"),
    OrbitCamera(yaw_turns: -0.5),

    // The long vertical traversal follows one selected explorer. Keeping the
    // remaining party at the apron avoids turning this camera proof into a
    // formation-routing benchmark through every contraction.
    Key("F"),
    AwaitButton("Party Movement Mode"),
    Click(name: "Party Movement Mode"),
    Key("Escape"),
    ClickAnchor(name: "crystal_mountain.foot_apron", expected: (q: -77, r: 3, level: 6)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: -77, r: 3, level: 6)),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: -0.3),
    Settle(60),
    Capture("03-crystal-mountain-foot-portal-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: 0.3),
    Settle(45),
    Capture("04-crystal-mountain-foot-portal-first-person"),

    ClickAnchor(name: "crystal_mountain.tunnel_mouth", expected: (q: -76, r: 1, level: 6)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: -76, r: 1, level: 6)),

    ClickAnchor(name: "crystal_mountain.midpoint", expected: (q: -48, r: -1, level: 6)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -48, r: -1, level: 6)),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: -0.3),
    Settle(60),
    Capture("05-crystal-mountain-natural-tunnel-first-person"),

    ClickAnchor(name: "crystal_mountain.gothic_transition", expected: (q: -29, r: -15, level: 6)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: -29, r: -15, level: 6)),
    OrbitCamera(yaw_turns: -0.25, pitch_fraction: 0.0),
    Settle(60),
    Capture("06-crystal-mountain-gothic-transition-first-person"),

    ClickAnchor(name: "crystal_mountain.ascent_threshold", expected: (q: -17, r: -15, level: 6)),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: -17, r: -15, level: 6)),

    ClickAnchor(name: "crystal_ascent.bottom_chamber", expected: (q: -8, r: -8, level: 6)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: -8, r: -8, level: 6)),
    Key("C"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: -0.08),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("07-crystal-mountain-crystal-chamber-first-person"),

    ClickAnchor(name: "crystal_ascent.mid_flight", expected: (q: 22, r: 0, level: 74)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 22, r: 0, level: 74)),
    OrbitCamera(yaw_turns: -0.16666667, pitch_fraction: 0.08),
    Key("C"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("08-crystal-mountain-mid-ascent-character"),

    ClickAnchor(name: "crystal_mountain.summit_exit", expected: (q: 16, r: 15, level: 150)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 16, r: 15, level: 150)),
    OrbitCamera(yaw_turns: 0.16666667, pitch_fraction: -0.08),
    Key("C"),
    AssertCameraMode(FirstPerson),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: 0.15),
    Settle(45),
    Capture("09-crystal-mountain-summit-exit-first-person"),

    ClickAnchor(name: "crystal_mountain.basin_clearing", expected: (q: 15, r: 20, level: 150)),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: 15, r: 20, level: 150)),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: -0.15),
    Key("C"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: 0.5, pitch_fraction: -0.15),
    Settle(45),
    Capture("10-crystal-mountain-wooded-basin-character"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

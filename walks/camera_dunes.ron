// Seed-exact survey of the dune field from both its authored crest and trough.
[
    AwaitScreen("Title"),
    StartScenario(name: "Dunes", seed: Some(1592598566), suppress_hostiles: true),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(60),
    Capture("01-dunes-ridge-field-map"),
    ClickTile(q: -8, r: 0, level: Some(18)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -8, r: 0, level: 18)),
    ClickTile(q: -4, r: 0, level: Some(19)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -4, r: 0, level: 19)),
    ClickAnchor(name: "dune_crest", expected: (q: 0, r: 0, level: 21)),
    Settle(5),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: 0, r: 0, level: 21)),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("02-dunes-crest-front-character"),
    OrbitCamera(yaw_turns: 0.33333334),
    Settle(45),
    Capture("03-dunes-crest-side-character"),

    Key("C"),
    AssertCameraMode(FirstPerson),
    Key("C"),
    AssertCameraMode(Map),
    Settle(30),
    ClickTile(q: -4, r: 4, level: Some(17)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -4, r: 4, level: 17)),
    ClickAnchor(name: "dune_trough", expected: (q: -6, r: 5, level: 15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: -6, r: 5, level: 15)),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.16666667),
    Settle(45),
    Capture("04-dunes-trough-front-character"),
    OrbitCamera(yaw_turns: -0.16666667),
    Settle(45),
    Capture("05-dunes-trough-ridge-wall-character"),

    Key("Backspace"),
    AwaitScreen("Title"),
]

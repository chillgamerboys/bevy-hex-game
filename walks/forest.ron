// Forest presentation walk. Run with:
//   HEX_WALK_SCRIPT=walks/forest.ron \
//   HEX_WALK_OUT=.context/visual-walks/forest \
//   cargo run -p hex_game --features visual-walk
[
    AwaitScreen("Title"),
    StartScenario(name: "Forest", seed: Some(381654729)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    // This route judges world/camera presentation, not the gameplay HUD.
    Key("H"),
    Settle(120),
    Capture("01-forest-map"),
    Key("C"),
    Settle(45),
    Capture("02-forest-character-canopy"),
    Key("C"),
    Key("H"),
    Key("Backspace"),
    AwaitScreen("Title"),
]

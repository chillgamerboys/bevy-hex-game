// One real route from the eastern gate, through the central courtyard, and up the
// authored switchback stairs to all three review elevations and across both lookout
// towers. The hostile holds the rear courtyard, leaving this complete inspection
// route outside engagement range.
[
    AwaitScreen("Title"),
    StartScenario(name: "Outpost", seed: Some(1290212)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    Key("C"),
    Settle(60),
    Capture("01-outpost-character-start"),

    ClickTile(q: 10, r: -5, level: Some(15)),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: 10, r: -5, level: 15)),
    Settle(45),
    Capture("02-outpost-gate-threshold"),

    ClickAnchor(name: "outpost_courtyard", expected: (q: 0, r: 0, level: 15)),
    AwaitPartyIdle(max_frames: 1800),
    AssertSelectedAt(expected: (q: 0, r: 0, level: 15)),
    OrbitCamera(yaw_turns: 0.33333334),
    OrbitCamera(yaw_turns: 0.16666667),
    Settle(45),
    Capture("03-outpost-courtyard"),

    ClickTile(q: 5, r: -7, level: Some(15)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: 5, r: -7, level: 15)),

    ClickTile(q: 8, r: -10, level: Some(18)),
    AwaitPartyIdle(max_frames: 1200),
    AssertSelectedAt(expected: (q: 8, r: -10, level: 18)),
    OrbitCamera(yaw_turns: 0.25),
    Settle(90),
    Capture("04-outpost-tight-stair-default"),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: 0.12),
    Settle(90),
    Capture("05-outpost-tight-stair-look-down"),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: -0.12),

    ClickAnchor(name: "outpost_front_walk", expected: (q: 8, r: -4, level: 22)),
    AwaitPartyIdle(max_frames: 1800),
    AssertSelectedAt(expected: (q: 8, r: -4, level: 22)),
    OrbitCamera(yaw_turns: -0.25, pitch_fraction: 0.3),
    Settle(60),
    Capture("06-outpost-front-walk-plus-7"),
    OrbitCamera(yaw_turns: -0.16666667),

    ClickAnchor(name: "outpost_wall_walk", expected: (q: -9, r: 0, level: 26)),
    AwaitPartyIdle(max_frames: 3000),
    AssertSelectedAt(expected: (q: -9, r: 0, level: 26)),
    Settle(60),
    Capture("07-outpost-wall-walk-plus-11"),

    ClickAnchor(name: "outpost_rooftop", expected: (q: 8, r: -8, level: 42)),
    AwaitPartyIdle(max_frames: 3600),
    AssertSelectedAt(expected: (q: 8, r: -8, level: 42)),
    Settle(60),
    Capture("08-outpost-north-lookout-plus-27"),

    ClickAnchor(name: "outpost_south_rooftop", expected: (q: 8, r: 0, level: 42)),
    AwaitPartyIdle(max_frames: 6000),
    AssertSelectedAt(expected: (q: 8, r: 0, level: 42)),
    Settle(60),
    Capture("09-outpost-south-lookout-plus-27"),
    OrbitCamera(yaw_turns: 0.33333334, pitch_fraction: -0.15),
    Settle(60),
    Capture("10-outpost-south-lookout-rear"),

    Key("Backspace"),
    AwaitScreen("Title"),
]

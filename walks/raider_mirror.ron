// Same-archetype identity and hostile-turn lockout without party or terrain noise.
[
    AwaitScreen("Title"),
    StartFixture(id: "raider-mirror"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    AwaitButton("Cast Metal Shield"),
    Settle(20),
    Capture("73-allied-raider-turn"),

    Click(name: "Cast Metal Shield"),
    AwaitButton("Confirm Cast"),
    Click(name: "Confirm Cast"),
    Settle(8),
    Capture("74-allied-raider-shielded"),
    Click(name: "End Turn"),

    AutoUntilAiCast,
    Settle(2),
    Capture("75-after-hostile-raider-shield"),
    AutoUntilPlayerTurn(0),
    Settle(2),
    Capture("76-allied-raider-round-two"),
]

// Real 144-level ascent from the lower apron through the crystal chamber and all
// three contracting stair circuits to the woodland summit. Every authored move is
// followed by bounded completion and an exact selected-surface proof.
[
    AwaitScreen("Title"),
    StartScenario(name: "Crystal Ascent", seed: Some(1592598566)),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    // The stair review follows the selected explorer. Keeping the other two party
    // members on the apron avoids making a 144-level camera proof depend on atomic
    // formation routing around every contraction.
    Key("F"),
    AwaitButton("Party Movement Mode"),
    Click(name: "Party Movement Mode"),
    Key("Escape"),
    Key("H"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    // Step onto the exterior sightline so the monumental arch fits in the close
    // camera instead of filling it edge to edge from the terminal pad.
    ClickTile(q: -20, r: -19, level: Some(6)),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -20, r: -19, level: 6)),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: -0.35),
    Settle(60),
    Capture("01-crystal-ascent-lower-exterior-entrance-character"),

    ClickAnchor(name: "crystal_ascent.bottom_chamber", expected: (q: -8, r: -8, level: 6)),
    AwaitPartyIdle(max_frames: 2400),
    AssertSelectedAt(expected: (q: -8, r: -8, level: 6)),
    // Restore the ordinary close-camera pitch. The entrance-axis bearing leaves
    // the complete heart beyond the explorer and centered in First Person.
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: 0.35),
    Settle(60),
    Capture("02-crystal-ascent-bottom-chamber-heart-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    Settle(45),
    Capture("03-crystal-ascent-bottom-chamber-heart-first-person"),

    ClickAnchor(name: "crystal_ascent.mid_flight", expected: (q: 22, r: 0, level: 74)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: 22, r: 0, level: 74)),
    OrbitCamera(yaw_turns: -0.16666667, pitch_fraction: 0.08),
    Settle(60),
    Capture("04-crystal-ascent-mid-flight-first-person"),
    Key("C"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("05-crystal-ascent-mid-flight-character"),

    ClickAnchor(name: "crystal_ascent.corner_landing", expected: (q: -10, r: 21, level: 134)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: -10, r: 21, level: 134)),
    // Character view keeps the outward crystal beside the boom.
    OrbitCamera(yaw_turns: 0.16666667),
    Settle(60),
    Capture("06-crystal-ascent-corner-landing-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    // First Person looks along the landing toward the next illuminated flight.
    OrbitCamera(yaw_turns: 0.16666667),
    Settle(45),
    Capture("07-crystal-ascent-corner-landing-first-person"),

    ClickAnchor(name: "crystal_ascent.upper_contraction", expected: (q: -19, r: 19, level: 138)),
    AwaitPartyIdle(max_frames: 7200),
    AssertSelectedAt(expected: (q: -19, r: 19, level: 138)),
    OrbitCamera(yaw_turns: -0.33333334, pitch_fraction: -0.04),
    Settle(60),
    Capture("08-crystal-ascent-upper-contraction-first-person"),
    Key("C"),
    AssertCameraMode(Map),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("09-crystal-ascent-upper-contraction-character"),

    ClickAnchor(name: "crystal_ascent.upper_exit", expected: (q: 16, r: 15, level: 150)),
    AwaitPartyIdle(max_frames: 4800),
    AssertSelectedAt(expected: (q: 16, r: 15, level: 150)),
    OrbitCamera(yaw_turns: -0.16666667),
    Settle(60),
    Capture("10-crystal-ascent-summit-oculus-clearing-character"),
    Key("C"),
    AssertCameraMode(FirstPerson),
    OrbitCamera(yaw_turns: 0.0, pitch_fraction: 0.15),
    Settle(45),
    Capture("11-crystal-ascent-summit-clearing-first-person"),
    Key("C"),
    AssertCameraMode(Map),
    Key("Backspace"),
    AwaitScreen("Title"),
]

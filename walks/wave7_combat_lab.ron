// Wave 7's one presentation-focused acceptance walk.
//
// Combat outcomes, tempo, occupancy, Channel accounting, run identity, and report
// fingerprints are verified from deterministic data. PresentFixtureReport only
// opens the ordinary report UI so this walk can review composition without a
// frame-sensitive combat solver.
[
    AwaitScreen("Title"),
    StartFixture(id: "channel-attrition"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(45),
    Capture("w7-01-live-dashboard"),

    StartFixture(id: "tempo-matrix", profile: Some("shipped")),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    PresentFixtureReport,
    AwaitButton("Retry Exact"),
    Settle(8),
    Capture("w7-02-report-overview"),
    Click(name: "Units"),
    Settle(4),
    Capture("w7-03-dense-units-report"),
    Click(name: "Save Report"),
    Click(name: "Retry Exact"),

    AwaitScreen("Gameplay"),
    AwaitTerrain,
    PresentFixtureReport,
    AwaitButton("Retry Exact"),
    Click(name: "Save Report"),
    Click(name: "Compare"),
    Click(name: "Report 1"),
    Settle(4),
    Capture("w7-04-outcome-compare"),
    Click(name: "Copy to Sandbox"),

    AwaitScreen("CombatLab"),
    Click(name: "Custom"),
    Click(name: "+", index: 0),
    Settle(8),
    Capture("w7-05-edited-rules"),
    Click(name: "Load Map & Deploy"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Settle(20),
    Capture("w7-06-retained-deployment"),
    Click(name: "SELECTED [P1]"),
    ClickTile(q: 0, r: 8),
    Settle(8),
    Capture("w7-07-direct-reposition"),
    Click(name: "Back to Rules"),
    AwaitScreen("CombatLab"),
    Settle(8),
    Capture("w7-08-rules-reentry"),
    Click(name: "Back to Rosters"),
    Click(name: "Back to Map"),
    Click(name: "Flat Arena"),
    Click(name: "Continue to Rosters"),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Add to roster", index: 0),
    Settle(2),
    Click(name: "Continue to Rules"),
    Click(name: "Load Map & Deploy"),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Click(name: "Deterministic Auto-place"),
    Settle(8),
    Capture("w7-09-six-by-six-deployment"),
    Click(name: "Start Combat"),
    Settle(45),
    Capture("w7-10-six-by-six-live-readability"),

// Seed-exact survey of the authored grass, ecotone, and sand bands. Every
// generated destination is followed by bounded movement and an exact arrival proof.
[
    AwaitScreen("Title"),
    StartScenario(name: "Desert Transition", seed: Some(1592598566), suppress_hostiles: true),
    AwaitScreen("Gameplay"),
    AwaitTerrain,
    Key("H"),
    AssertCameraMode(Map),
    Settle(60),
    Capture("01-desert-transition-bands-map"),
    ClickTile(q: -8, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -8, r: 0, level: 15)),
    ClickTile(q: -4, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: -4, r: 0, level: 15)),
    ClickAnchor(name: "grass_overlook", expected: (q: -1, r: 0, level: 15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 1800),
    AssertSelectedAt(expected: (q: -1, r: 0, level: 15)),
    Key("C"),
    AssertCameraMode(Character),
    Settle(45),
    Capture("02-desert-transition-grass-front-character"),
    OrbitCamera(yaw_turns: 0.33333334),
    Settle(45),
    Capture("03-desert-transition-grass-reverse-character"),

    Key("C"),
    AssertCameraMode(FirstPerson),
    Key("C"),
    AssertCameraMode(Map),
    Settle(30),
    ClickAnchor(name: "transition_center", expected: (q: 0, r: 0, level: 15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 1800),
    AssertSelectedAt(expected: (q: 0, r: 0, level: 15)),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.16666667),
    Settle(45),
    Capture("04-desert-transition-ecotone-character"),

    Key("C"),
    AssertCameraMode(FirstPerson),
    Key("C"),
    AssertCameraMode(Map),
    Settle(30),
    ClickTile(q: 4, r: 0, level: Some(15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 600),
    AssertSelectedAt(expected: (q: 4, r: 0, level: 15)),
    ClickAnchor(name: "sand_overlook", expected: (q: 8, r: 0, level: 15)),
    Settle(5),
    AwaitPartyIdle(max_frames: 1800),
    AssertSelectedAt(expected: (q: 8, r: 0, level: 15)),
    Key("C"),
    AssertCameraMode(Character),
    OrbitCamera(yaw_turns: -0.16666667),
    Settle(45),
    Capture("05-desert-transition-sand-front-character"),
    OrbitCamera(yaw_turns: 0.33333334),
    Settle(45),
    Capture("06-desert-transition-sand-reverse-character"),

    Key("Backspace"),
    AwaitScreen("Title"),
]
